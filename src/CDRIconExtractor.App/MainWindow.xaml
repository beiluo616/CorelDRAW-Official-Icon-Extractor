<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:CDRIconExtractor.App.ViewModels" x:Class="CDRIconExtractor.App.MainWindow" Title="CorelDRAW官方图标提取器 - By北落果" Icon="Assets/f10ai.ico" Width="1180" Height="760" MinWidth="980" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="CorelDRAW官方图标提取器" FontSize="23" FontWeight="SemiBold" Foreground="#1F2937"/>
                <TextBlock Text="CorelDRAW 官方图标提取器  / GUID 开发工具" Margin="0,3,0,0" Foreground="#667085"/>
            </StackPanel>
            <Button Grid.Column="1" Content="关于" Click="About_Click" Padding="12,4" VerticalAlignment="Top"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CorelDRAW版本" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Installations}" SelectedItem="{Binding SelectedInstallation}" DisplayMemberPath="DisplayName"/>
                <Button Grid.Column="2" Content="刷新版本" Command="{Binding RefreshVersionsCommand}" Margin="8,0,0,0"/>
                <Button Grid.Column="3" Content="加载CrlIcons.dll" Command="{Binding LoadCrlIconsCommand}" Margin="8,0,0,0" ToolTip="直接加载任意 CrlIcons.dll 作为图标资源，不要求安装对应 CorelDRAW"/>
                <Button Grid.Column="4" Content="加载新版图标资源" Command="{Binding LoadModernIconsCommand}" Margin="8,0,0,0" ToolTip="加载 Modern.crlicons + icons.map.xml；优先自动查找映射文件，找不到时提示手动选择"/>
                <Button Grid.Column="5" Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}" Margin="8,0,0,0" Background="{StaticResource AccentSoftBrush}"/>
                <CheckBox Grid.Column="6" Content="深度扫描" IsChecked="{Binding DeepScan}" VerticalAlignment="Center" Margin="12,0,0,0" ToolTip="额外扫描 CorelDRAW 程序目录中的 DLL 资源，耗时更长"/>
                <ProgressBar Grid.Column="7" Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="7" Margin="18,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="White" BorderBrush="#7AA7F7" BorderThickness="1" CornerRadius="7" ClipToBounds="True" VerticalAlignment="Top" Grid.Row="0" Margin="0,0,0,7">
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,6" MinHeight="34" BorderThickness="0" Background="Transparent"/>
                        <TextBlock Text="中文智能搜索：转曲、焊接、解组、二维码、Convert to Curves、Ctrl+Q、GUID、资源ID、文件名等" Margin="11,0,8,0" VerticalAlignment="Center" Foreground="#98A2B3" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True" Grid.Row="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DataGrid x:Name="ListGrid" Grid.Row="0" ItemsSource="{Binding ListItems}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconWall}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="选" Width="42">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsMarked, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="图标" Width="58">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="38" Height="38" Margin="3" Background="#FAFAFA">
                                                <Image Source="{Binding Preview}" Stretch="Uniform" SnapsToDevicePixels="True"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="名称" Binding="{Binding LocalizedCaption}" Width="150"/>
                                <DataGridTextColumn Header="英文名称" Binding="{Binding Caption}" Width="170"/>
                                <DataGridTextColumn Header="快捷键" Binding="{Binding Shortcut}" Width="85"/>
                                <DataGridTextColumn Header="GUID" Binding="{Binding PrimaryGuid}" Width="230"/>
                                <DataGridTextColumn Header="GUID关系" Binding="{Binding GuidRelation}" Width="150"/>
                                <DataGridTextColumn Header="关联" Binding="{Binding Confidence}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconWall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <ItemsControl ItemsSource="{Binding WallItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IconItemViewModel}">
                                        <Button Width="124" Height="118" Padding="6" Margin="5" CommandParameter="{Binding}" Click="IconTile_Click" Background="White" BorderBrush="#E1E5EC">
                                            <Button.ToolTip>
                                                <StackPanel MaxWidth="460">
                                                    <TextBlock Text="{Binding LocalizedCaption}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Caption}" Foreground="#667085"/>
                                                    <TextBlock Text="{Binding Shortcut}" Foreground="#667085"/>
                                                    <TextBlock Text="{Binding IconGuid}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Button.ToolTip>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsMarked, Mode=TwoWay}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-1,0,0" Panel.ZIndex="2" ToolTip="勾选后可批量生成 VBA / C++ 图标注册模板"/>
                                                <StackPanel Margin="0,2,0,0">
                                                    <Border Width="60" Height="60" Background="#F8FAFC" HorizontalAlignment="Center">
                                                        <Image Source="{Binding Preview}" Stretch="Uniform"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding LocalizedCaption}" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,6,0,0"/>
                                                    <TextBlock Text="{Binding ResourceId}" FontSize="10" Foreground="#98A2B3" TextAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,6">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIconWall}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Content="上一页" Command="{Binding PreviousPageCommand}" MinWidth="72"/>
                            <TextBlock Text="{Binding PageSummary}" Margin="12,0" VerticalAlignment="Center" Foreground="#667085"/>
                            <Button Content="下一页" Command="{Binding NextPageCommand}" MinWidth="72"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,7">
                    <Border Background="#EEF2F7" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="7" Padding="6,5" Margin="0,0,0,5">
                        <StackPanel>
                            <TextBlock Text="筛选" FontSize="11" Foreground="#667085" Margin="2,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="全部命令" GroupName="FilterMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFilterAllCommands, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="全部命令"/>
                                <RadioButton Content="有图标" GroupName="FilterMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFilterHasIcon, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="有图标"/>
                                <RadioButton Content="待验证" GroupName="FilterMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFilterPending, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="待验证" ToolTip="已识别图标 GUID，但当前没有可显示的本地预览图"/>
                                <RadioButton Content="未关联" GroupName="FilterMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFilterUnmapped, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="未关联"/>
                                <RadioButton Content="原始资源" GroupName="FilterMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsFilterRawResources, Mode=OneWay}" Command="{Binding SetFilterCommand}" CommandParameter="原始资源"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="#F8FAFC" BorderBrush="#D8DEE8" BorderThickness="1" CornerRadius="7" Padding="6,5">
                        <StackPanel>
                            <TextBlock Text="视图" FontSize="11" Foreground="#667085" Margin="2,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="图标墙" GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsIconWall, Mode=OneWay}" Command="{Binding SetViewCommand}" CommandParameter="wall"/>
                                <RadioButton Content="列表" GroupName="ViewMode" Style="{StaticResource SegmentRadioStyle}" IsChecked="{Binding IsListView, Mode=OneWay}" Command="{Binding SetViewCommand}" CommandParameter="list"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="图标详情" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="142"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="142" Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5">
                                    <Image Source="{Binding SelectedItem.Preview}" Stretch="Uniform" Margin="10"/>
                                </Border>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="名称" Foreground="#667085" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItem.LocalizedCaption}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,1,0,6"/>
                                    <TextBlock Text="英文名称" Foreground="#667085" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItem.Caption}" TextWrapping="Wrap" Margin="0,1,0,6"/>
                                    <Grid Margin="0,1,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="快捷键" Foreground="#667085" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedItem.Shortcut}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="资源ID" Foreground="#667085" FontSize="11"/>
                                            <TextBlock Text="{Binding SelectedItem.ResourceId}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="可用尺寸" Foreground="#667085" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItem.AvailableSizes}"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="24" Command="{Binding SetPreviewSizeCommand}" CommandParameter="24" Padding="6,2" MinWidth="34"/>
                                        <Button Content="48" Command="{Binding SetPreviewSizeCommand}" CommandParameter="48" Padding="6,2" MinWidth="34"/>
                                        <Button Content="72" Command="{Binding SetPreviewSizeCommand}" CommandParameter="72" Padding="6,2" MinWidth="34"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                            <Separator Margin="0,0,0,10"/>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.ShowCombinedGuid}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding SelectedItem.PrimaryGuidLabel}" Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedItem.PrimaryGuid}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,4"/>
                                <WrapPanel>
                                    <Button Content="复制GUID" Command="{Binding CopyPrimaryGuidCommand}" Padding="8,4" MinHeight="26"/>
                                    <Button Content="复制 guid://" Command="{Binding CopyIconGuidUriCommand}" Padding="8,4" MinHeight="26"/>
                                    <Button Content="复制 icon=引用" Command="{Binding CopyIconAttributeCommand}" Padding="8,4" MinHeight="26"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.ShowSeparateGuids}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="命令 GUID" Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedItem.CommandGuid}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,3"/>
                                <Button Content="复制命令GUID" Command="{Binding CopyCommandGuidCommand}" HorizontalAlignment="Left" Padding="8,4" MinHeight="26" Margin="0,0,0,7"/>
                                <TextBlock Text="图标 GUID" Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedItem.IconGuid}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,3"/>
                                <WrapPanel>
                                    <Button Content="复制图标GUID" Command="{Binding CopyIconGuidCommand}" Padding="8,4" MinHeight="26"/>
                                    <Button Content="复制 guid://" Command="{Binding CopyIconGuidUriCommand}" Padding="8,4" MinHeight="26"/>
                                    <Button Content="复制 icon=引用" Command="{Binding CopyIconAttributeCommand}" Padding="8,4" MinHeight="26"/>
                                </WrapPanel>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,8">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem.HasMultipleIconGuids}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="其他可用图标 GUID（同一官方图片可由多个 GUID 复用）" Foreground="#667085"/>
                                <TextBlock Text="{Binding SelectedItem.OtherIconGuidsText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedItem.GuidRelation}" Foreground="#475467" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <Border Background="#F8FAFC" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="5" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="图标 GUID 实机状态" Foreground="#667085" FontSize="11"/>
                                    <TextBlock Text="{Binding SelectedItem.IconValidationStatus}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,4"/>
                                    <TextBlock Text="{Binding SelectedItem.IconValidationMessage}" TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="0,0,0,5"/>
                                    <Button Content="实机验证GUID" Command="{Binding ValidateIconGuidCommand}" HorizontalAlignment="Left" Padding="9,4" MinHeight="26" ToolTip="需要先打开当前选择的 CorelDRAW 版本；验证 SetIcon2 是否接受该内部图标 GUID"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,0,0,5">
                                <Button Content="生成 VBA 模板" Command="{Binding CopyVbaTemplateCommand}" Padding="8,4" MinHeight="26" ToolTip="当前图标：打开 VBA 代码窗口"/>
                                <Button Content="生成 C++/CPG 模板" Command="{Binding CopyCppTemplateCommand}" Padding="8,4" MinHeight="26" ToolTip="当前图标：打开 C++/CPG 代码窗口"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,10">
                                <Button Content="批量 VBA 模板" Command="{Binding GenerateBatchVbaTemplateCommand}" Padding="8,4" MinHeight="26" ToolTip="先在图标墙或列表勾选多个图标"/>
                                <Button Content="批量 C++/CPG 模板" Command="{Binding GenerateBatchCppTemplateCommand}" Padding="8,4" MinHeight="26" ToolTip="先在图标墙或列表勾选多个图标"/>
                                <Button Content="清除勾选" Command="{Binding ClearMarkedCommand}" Padding="8,4" MinHeight="26"/>
                            </WrapPanel>
                            <TextBlock Text="GuidRef（原始UI引用）" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.GuidRef}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8"/>
                            <TextBlock Text="CorelDRAW 内部图标引用" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.IconAttribute}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,2,0,8"/>
                            <TextBlock Text="关联状态 / 原因" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.Confidence}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedItem.Reason}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                            <TextBlock Text="GUID映射来源" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.IconGuidSource}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8"/>
                            <TextBlock Text="来源文件" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.SourceFile}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8"/>
                            <TextBlock Text="资源路径" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.ResourcePath}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,7"/>
                            <TextBlock Text="SHA-256" Foreground="#667085"/>
                            <TextBlock Text="{Binding SelectedItem.Sha256}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,9,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" Foreground="#475467"/>
                <TextBlock Text="{Binding ResultSummary}" FontSize="11" Foreground="#98A2B3" Margin="0,2,0,0"/>
                <TextBlock Text="{Binding DiagnosticSummary}" FontSize="10" Foreground="#98A2B3" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DiagnosticSummary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="导出当前" Command="{Binding ExportCurrentCommand}"/>
                <Button Content="批量导出" Command="{Binding ExportBatchCommand}"/>
                <Button Content="打开输出目录" Command="{Binding OpenOutputCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
